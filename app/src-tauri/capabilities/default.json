{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every Spate window: events, closing/dragging its own window, the app's commands.",
  "windows": ["main", "popover", "island", "card-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-start-dragging"
  ]
}
